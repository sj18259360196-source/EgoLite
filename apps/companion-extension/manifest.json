{
  "manifest_version": 3,
  "name": "Ego Windows Companion",
  "version": "0.0.1",
  "key": "",
  "description": "Explicitly grants selected Edge or Chrome tabs to Ego task spaces.",
  "permissions": [
    "debugger",
    "tabs",
    "windows",
    "storage",
    "nativeMessaging",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["selection.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Ego Companion",
    "default_popup": "popup.html"
  },
  "side_panel": { "default_path": "sidepanel.html" }
}
