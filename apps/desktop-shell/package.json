{
  "name": "@ego-compat/desktop-shell",
  "version": "0.2.12-cos.11",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "description": "EgoLite AI 自动化浏览器桌面端",
  "author": "EgoLite",
  "scripts": {
    "start": "electron ."
  },
  "build": {
    "appId": "com.egolite.browser",
    "productName": "EgoLite",
    "electronVersion": "43.1.0",
    "electronDist": "../../node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "../../release"
    },
    "files": [
      "**/*",
      "!**/*.test.mjs"
    ],
    "extraResources": [
      {
        "from": "../../.packaging/runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/assets/ego-app.ico"
    },
    "nsis": {
      "artifactName": "EgoLite-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EgoLite"
    },
    "portable": {
      "artifactName": "EgoLite-Portable-${version}-${arch}.${ext}"
    }
  }
}
